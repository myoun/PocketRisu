{
  "id": "codex",
  "version": 1,
  "displayName": "Codex (ChatGPT)",
  "adapterKind": "codex-responses",
  "authKinds": ["bearer"],
  "endpointKinds": ["static"],
  "defaultHeaders": { "Content-Type": "application/json" },
  "defaultBody": {},
  "requestSchema": [
    {
      "key": "apiKey",
      "type": "string",
      "label": "Access Token",
      "description": "OAuth access token copied from Codex Manager. It is short-lived; copy a refreshed value when needed.",
      "secret": true,
      "required": true,
      "mapsTo": { "target": "auth", "path": "apiKey" }
    },
    {
      "key": "accountId",
      "type": "string",
      "label": "ChatGPT Account ID",
      "description": "ChatGPT-Account-Id copied from Codex Manager.",
      "required": true,
      "mapsTo": { "target": "header", "path": "ChatGPT-Account-Id" }
    },
    {
      "key": "modelId",
      "type": "string",
      "label": "Model ID",
      "required": true,
      "mapsTo": { "target": "body", "path": "model" },
      "description": "Codex model identifier provided by your ChatGPT account."
    },
    {
      "key": "reasoningEffort",
      "type": "string",
      "label": "Reasoning Effort",
      "enum": [
        { "value": "low", "label": "Low" },
        { "value": "medium", "label": "Medium" },
        { "value": "high", "label": "High" },
        { "value": "xhigh", "label": "Extra High" }
      ],
      "default": "medium",
      "mapsTo": { "target": "body", "path": "reasoning.effort" }
    }
  ],
  "uiSchema": {
    "groups": [{ "id": "credentials", "label": "Credentials" }, { "id": "model", "label": "Model" }],
    "fields": [
      { "key": "apiKey", "widget": "secret", "visibility": "basic", "group": "credentials", "placeholder": "Access token from Codex Manager" },
      { "key": "accountId", "widget": "text", "visibility": "basic", "group": "credentials", "placeholder": "ChatGPT Account ID from Codex Manager" },
      { "key": "modelId", "widget": "text", "visibility": "basic", "group": "model" },
      { "key": "reasoningEffort", "widget": "select", "visibility": "advanced", "group": "model" }
    ]
  },
  "capabilities": ["streaming", "tools", "reasoning"],
  "sourceUrls": ["https://chatgpt.com/backend-api/codex/responses"]
}
